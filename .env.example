# Copy to .env for local testing (node --env-file=.env tests/unit/...)
# In deployed environments these are resolved from SSM Parameter Store via
# template.yaml — this file is for local dev only. Never commit the real .env.

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# E.164 without the leading +, e.g. 2348012345678
EMERGENCY_CONTACT_NUMBER=

# Phase 2.0 AI classification — free tier, no card required:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret the dashboard sends as the x-dashboard-key header.
# Any strong random string — this gates functions/incidents-api.
DASHBOARD_API_KEY=

# Only needed if testing incidentService.js locally against a real table
INCIDENTS_TABLE=rescuehacks-incidents
